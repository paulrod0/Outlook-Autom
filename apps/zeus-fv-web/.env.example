# Base de datos Neon (Postgres serverless). Opcional.
# Sin esta variable, los proyectos se guardan en localStorage del navegador.
# Crea un proyecto gratis en https://neon.tech y copia aquí la cadena de conexión.
DATABASE_URL=

# Mapa base (opcional). Si no se rellena, se usa Esri World Imagery (gratis con atribución).
NEXT_PUBLIC_MAPBOX_TOKEN=

# PVGIS no requiere key, pero permite override del endpoint si JRC cambia.
PVGIS_BASE_URL=https://re.jrc.ec.europa.eu/api/v5_3
