# Base de datos Neon (Postgres serverless). Opcional.
# Sin esta variable, los proyectos se guardan en localStorage del navegador.
# Crea un proyecto gratis en https://neon.tech y copia aquí la cadena de conexión.
DATABASE_URL=

# Mapa base (opcional). Si no se rellena, se usa Esri World Imagery (gratis con atribución).
NEXT_PUBLIC_MAPBOX_TOKEN=

# PVGIS no requiere key, pero permite override del endpoint si JRC cambia.
PVGIS_BASE_URL=https://re.jrc.ec.europa.eu/api/v5_3

# ------------------------------------------------------------------
# Auth.js (NextAuth v5) — acceso interno del equipo comercial.
# ------------------------------------------------------------------
# AUTH_SECRET: cualquier string aleatorio largo (mínimo 32 caracteres).
# Generar con: openssl rand -base64 32
AUTH_SECRET=

# AUTH_ENFORCE=1 fuerza login en todas las rutas. Sin él la app va abierta
# (útil en demos y previews internos).
AUTH_ENFORCE=

# Lista de usuarios autorizados como JSON. Generar passwordHash con bcrypt:
#   node -e "console.log(require('bcryptjs').hashSync('miClave', 10))"
# AUTH_USERS=[{"email":"pablo@zeus.es","name":"Pablo","passwordHash":"$2b$10$..."}]
AUTH_USERS=

# AUTH_DEV_PASSWORD: contraseña común para todos los emails. SÓLO desarrollo,
# se ignora en NODE_ENV=production.
AUTH_DEV_PASSWORD=

# ------------------------------------------------------------------
# SolarEdge Monitoring API — post-venta (M9).
# ------------------------------------------------------------------
# API key a nivel de cuenta. Solicitar al admin del portal SolarEdge.
SOLAREDGE_API_KEY=

# Override opcional del endpoint (raramente necesario).
SOLAREDGE_BASE_URL=https://monitoringapi.solaredge.com

# Secreto compartido con Vercel Cron para autorizar /api/solaredge/sync.
# Vercel envía 'Authorization: Bearer ${CRON_SECRET}' automáticamente en
# las invocaciones de cron en producción.
CRON_SECRET=

# ------------------------------------------------------------------
# Branding del PDF de oferta.
# ------------------------------------------------------------------
# Si vale "1", el header del PDF usa public/branding/logo.png en lugar
# del monograma "Z" por defecto.
NEXT_PUBLIC_BRAND_LOGO=
